# Copy to `.env` on the server. compose.yml sets ORIGIN, DATABASE_PATH, FILES_DIR and PORT itself.
# Domain Caddy serves and requests a certificate for. Without a domain use <ip-with-dashes>.sslip.io.
APP_DOMAIN=
# At least 32 characters: openssl rand -base64 48
SESSION_SECRET=
MAIL_DRIVER=fake
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
PUSH_DRIVER=fake
LOG_LEVEL=info
